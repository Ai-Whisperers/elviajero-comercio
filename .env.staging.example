# El Viajero - STAGING environment
# Copy to .env.staging on the VPS. Do not commit real secrets.

NODE_ENV=production
APP_ENV=staging
NEXT_PUBLIC_BASE_URL=https://elviajero-staging.paragu-ai.com

# Recommended: separate Supabase project for staging.
# If temporarily sharing prod Supabase, do NOT let clients edit real products/orders there.
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_staging_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_staging_service_role_key

EVOLUTION_API_URL=http://evolution_evolution_api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=elviajero-staging
ADMIN_WHATSAPP=595984009751
NEXT_PUBLIC_WHATSAPP=595984009751
