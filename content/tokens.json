{
  "$comment": "Dayah Dark v3 — real contrast hierarchy. Each layer is visually distinct. Surfaces have borders. Cards lift with shadow.",
  "extends": "vertical:portfolio-professional",
  "theme": "dark",
  "defaultPalette": "default",
  "palettes": {
    "default": {
      "name": "Dayah Dark v3",
      "colors": {
        "primary": "#94abd6",
        "primaryForeground": "#0a0a14",
        "secondary": "#d43d5e",
        "secondaryForeground": "#ffffff",
        "accent": "#7da3d6",
        "accentForeground": "#0a0a14",
        "background": "#0a0a14",
        "surface": "#11132a",
        "surfaceLight": "#1b2040",
        "text": "#eaeaea",
        "textLight": "#d0d6e6",
        "textMuted": "#a0aac8",
        "success": "#64ffda",
        "warning": "#ffd93d"
      }
    }
  },
  "typography": {
    "heading": "'Playfair Display', serif",
    "body": "'Inter', sans-serif",
    "headingWeight": "800",
    "bodyWeight": "400"
  },
  "googleFonts": [
    "Playfair+Display:wght@600;700;800",
    "Inter:wght@400;500;600;700"
  ],
  "borderRadius": "0.5rem",
  "components": {
    "portfolio": {
      "gap": "1.5rem",
      "cols-lg": "repeat(4, minmax(0, 1fr))"
    },
    "testimonials": {
      "card-shadow": "0 1px 4px rgba(0,0,0,0.25)"
    }
  }
}
